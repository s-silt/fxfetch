# Windows Docker Desktop: private directories, never the original VM disk.
# Copy this file to .env and provide already prepared absolute paths.
FXFETCH_ANDROID_STATE=E:/private/fxfetch-android/vm
# Contains android-worker.json, pinned known_hosts, and the dedicated SSH key.
# Config paths inside JSON must use /run/fxfetch-worker/<filename>, not host paths.
FXFETCH_ANDROID_CONFIG_DIR=E:/private/fxfetch-android/api-worker
# This acceptance Compose file publishes only 127.0.0.1:18765. No SSH/CDP/broker ports.
# Optional compose.build.yaml only. Run init-build with container paths to configure.
# FXFETCH_LINUX_SDK=E:/private/fxfetch-tools/android-sdk-linux
# FXFETCH_FONTS=E:/private/fxfetch-tools/fonts
