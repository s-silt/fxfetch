# Copy to .env in this directory. No password, signing key or target URL belongs here.
# Keep the default for local acceptance. Set an explicit RFC1918 host IP only after LAN review.
FXFETCH_PUBLIC_IP=127.0.0.1
FXFETCH_PORT=18765
# Change all three together if this bridge conflicts with an existing network.
FXFETCH_CONTAINER_SUBNET=172.30.246.0/28
FXFETCH_CONTAINER_IP=172.30.246.2
FXFETCH_TRUSTED_PEERS=172.30.246.1/32
# Optional compose.build.yaml: Linux SDK, never the Windows or macOS SDK directory.
# FXFETCH_LINUX_SDK=/absolute/private/path/android-sdk-linux
# Optional offline analysis: an already provisioned Linux executable INSIDE the API container.
# FXFETCH_FXAPK=/opt/fxapk/venv/bin/fxapk
# A digest can replace the tag after platform-specific acceptance.
# FXFETCH_PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:<verified digest>
